{
  "name": "@kinetic/enterprise",
  "version": "0.1.0",
  "description": "Advanced enterprise-grade components built on @kinetic/react for complex business applications",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kinetic-ui/kinetic.git",
    "directory": "packages/enterprise"
  },
  "scripts": {
    "dev": "rollup -c rollup.config.mjs --watch",
    "build": "node scripts/build.mjs --tsc",
    "build:fast": "node scripts/build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kinetic/react": "workspace:*",
    "@kinetic/styles": "workspace:*",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/utilities": "^3.2.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/react": "^0.1.1",
    "react-json-view-compare": "^1.1.0",
    "@monaco-editor/react": "^4.5.0",
    "@blocknote/react": "^0.12.0",
    "@blocknote/core": "^0.12.0",
    "recharts": "^2.10.3",
    "react-pdf": "^7.7.0",
    "react-big-calendar": "^1.8.5",
    "react-md-editor": "^4.0.3",
    "date-fns": "^3.0.0",
    "clsx": "^2.0.0",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "tailwindcss": ">=4.0.0"
  },
  "devDependencies": {
    "@kinetic/react": "workspace:*",
    "@kinetic/styles": "workspace:*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.3.3"
  }
}
